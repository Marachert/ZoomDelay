<Window x:Class="LogAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LogAnalyzer.App.Converters"
        Title="Log Analyzer" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:HeatmapBrushConverter x:Key="HeatmapBrushConverter" />
        <conv:IndentThicknessConverter x:Key="IndentThicknessConverter" />
        <conv:GridLengthConverter x:Key="GridLengthConverter" />
        <conv:HeavyWindowBrushConverter x:Key="HeavyWindowBrushConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#8A8A8A" BorderThickness="2" CornerRadius="6" Padding="16" Background="#FAFAFA"
                AllowDrop="True" DragEnter="OnDragEnter" Drop="OnDrop">
            <TextBlock Text="Drop a folder here to analyze .log files (including subfolders)." FontSize="16" FontWeight="SemiBold" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <Button Content="Select Folder" Width="120" Margin="0,0,8,0" Click="OnSelectFolder" />
            <Button Content="Cancel" Width="90" Margin="0,0,12,0" Command="{Binding CancelCommand}" />
            <ProgressBar Width="240" Height="18" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
            <TextBlock Text=" " Width="12" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0" Height="28" Background="#F0F0F0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ElementName=ResultsGrid, Path=Columns[0].ActualWidth, Converter={StaticResource GridLengthConverter}}" />
                    <ColumnDefinition Width="{Binding ElementName=ResultsGrid, Path=Columns[1].ActualWidth, Converter={StaticResource GridLengthConverter}}" />
                    <ColumnDefinition Width="{Binding ElementName=ResultsGrid, Path=Columns[2].ActualWidth, Converter={StaticResource GridLengthConverter}}" />
                    <ColumnDefinition Width="{Binding ElementName=ResultsGrid, Path=Columns[3].ActualWidth, Converter={StaticResource GridLengthConverter}}" />
                    <ColumnDefinition Width="{Binding ElementName=ResultsGrid, Path=Columns[4].ActualWidth, Converter={StaticResource GridLengthConverter}}" />
                    <ColumnDefinition Width="{Binding ElementName=ResultsGrid, Path=Columns[5].ActualWidth, Converter={StaticResource GridLengthConverter}}" />
                    <ColumnDefinition Width="{Binding ElementName=ResultsGrid, Path=Columns[6].ActualWidth, Converter={StaticResource GridLengthConverter}}" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                    <TextBlock Text="AM.Archiving" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
                <Border Grid.Column="3" Grid.ColumnSpan="4" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                    <TextBlock Text="Interaction.MediaRetrieval" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                </Border>
            </Grid>
        </Grid>

        <DataGrid x:Name="ResultsGrid" Grid.Row="3" ItemsSource="{Binding Results}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column" Sorting="OnGridSorting"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" RowHeight="28">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="#E0E0E0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="ToolTip" Value="{Binding TooltipText}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RowType}" Value="Archive">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="{Binding AnomalyScore, Converter={StaticResource HeatmapBrushConverter}}" />
                            <Setter Property="BorderThickness" Value="4,0,0,1" />
                            <Setter Property="BorderBrush" Value="{Binding HeavyWindowScore, Converter={StaticResource HeavyWindowBrushConverter}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RowType}" Value="Media">
                            <Setter Property="Background" Value="{Binding AnomalyScore, Converter={StaticResource HeatmapBrushConverter}, ConverterParameter=Media}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Width="180" Header="ArchiveStartDateTime" Binding="{Binding ArchiveStartDateTimeDisplay, StringFormat=G}" SortMemberPath="ArchiveStartDateTime" Tag="ArchiveStartDateTime">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,0,4,0" />
                            <Setter Property="Margin" Value="{Binding DisplayIndentLevel, Converter={StaticResource IndentThicknessConverter}}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Width="120" Header="ArchivedCount" Binding="{Binding ArchivedCountDisplay}" SortMemberPath="ArchivedCount" Tag="ArchivedCount" />
                <DataGridTextColumn Width="140" Header="Duration" Binding="{Binding DurationDisplay}" SortMemberPath="Duration" Tag="Duration" />
                <DataGridTextColumn Width="220" Header="InteractionId" Binding="{Binding InteractionIdDisplay}" SortMemberPath="InteractionId" Tag="InteractionId" />
                <DataGridTextColumn Width="180" Header="InteractionStartTime" Binding="{Binding InteractionStartTimeDisplay, StringFormat=G}" SortMemberPath="InteractionStartTime" Tag="InteractionStartTime" />
                <DataGridTextColumn Width="180" Header="InteractionStopTime" Binding="{Binding InteractionStopTimeDisplay, StringFormat=G}" SortMemberPath="InteractionStopTime" Tag="InteractionStopTime" />
                <DataGridTextColumn Width="160" Header="InteractionDuration" Binding="{Binding InteractionDurationDisplay}" SortMemberPath="InteractionDuration" Tag="InteractionDuration" />
            </DataGrid.Columns>
        </DataGrid>

        <Expander Grid.Row="4" Header="Diagnostics" IsExpanded="False" Margin="0,12,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Files:" Margin="0,0,6,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Diagnostics.TotalFiles}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Total Lines:" Margin="0,0,6,4" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Diagnostics.TotalLines}" Margin="0,0,12,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Archive Matches:" Margin="0,0,6,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Diagnostics.MatchedArchiveLines}" Margin="0,0,12,4" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Media Matches:" Margin="0,0,6,4" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Diagnostics.MatchedMediaLines}" Margin="0,0,12,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Skipped Lines:" Margin="0,0,6,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Diagnostics.SkippedLines}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Unmatched Media:" Margin="0,0,6,0" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Diagnostics.UnmatchedMediaEvents}" />
            </Grid>
        </Expander>
    </Grid>
</Window>
